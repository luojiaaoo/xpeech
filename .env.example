# Docker Compose 项目名，用作容器、网络等资源的名称前缀
COMPOSE_PROJECT_NAME=xpeech

# Compose 中所有服务共用的 PostgreSQL 数据库
POSTGRES_DB=xpeech
POSTGRES_USER=xpeech
POSTGRES_PASSWORD=replace-with-a-database-password

# PostgreSQL 对外端口（默认：7890）
# POSTGRES_PORT=7890

# 后端 API 对外端口（默认：7878）
# BACKEND_PORT=7878

# 后端 API 实例数（默认：8）
# BACKEND_REPLICAS=8

# Web 客户端对外端口（默认：7939）
# WEB_CLIENT_PORT=7939
