# Docker Compose 项目名，用作容器、网络等资源的名称前缀
COMPOSE_PROJECT_NAME=xpeech

# Absolute directory on the Docker daemon host, e.g. /srv/xpeech/docker_data.
# It must contain session/, workspace_base/, cache/, browser_preview/ and sandbox-home/.
XPEECH_HOST_DATA_PATH=/srv/xpeech/docker_data

# Generate a dedicated OpenSandbox control-plane API key; do not reuse the JWT key.
OPENSANDBOX_API_KEY=replace-with-an-independent-opensandbox-api-key

# 后端 API 对外端口（默认：7878）
# BACKEND_PORT=7878

# Web 客户端对外端口（默认：7939）
# WEB_CLIENT_PORT=7939

# Browserless Chromium 的容器内 CDP 地址
CDP_URL=ws://browserless:3000
