# Docker Compose 项目名，用作容器、网络等资源的名称前缀
COMPOSE_PROJECT_NAME=xpeech

# 初始化的 PostgreSQL 数据库
POSTGRES_DB=xpeech
POSTGRES_USER=xpeech
POSTGRES_PASSWORD=replace-with-a-database-password

# 初始化的 Redis
REDIS_USERNAME=xpeech
REDIS_PASSWORD=replace-with-a-database-password

# 魔搭 tokenizer 模型 ID，须与 conf.toml 中的 llm.tokenizer.model 一致
VLLM_TOKENIZER_MODEL=Qwen/Qwen3.8-27B

# PostgreSQL 对外端口（默认：7890）
# POSTGRES_PORT=7890

# 后端 API 对外端口（默认：7878）
# BACKEND_PORT=7878

# 后端 API 实例数（默认：8）
# BACKEND_REPLICAS=8

# Web 客户端对外端口（默认：7939）
# WEB_CLIENT_PORT=7939
