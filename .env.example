# Docker Compose 项目名，用作容器、网络等资源的名称前缀
COMPOSE_PROJECT_NAME=xpeech

# Docker 宿主机上本项目的绝对路径，例如 /srv/xpeech（不要填写 /app）。
XPEECH_HOST_ROOT=/srv/xpeech
# 用 uv run python -c "import secrets; print(secrets.token_hex(32))" 生成。
OPENSANDBOX_API_KEY=replace-with-a-random-opensandbox-api-key
# 默认 Docker bridge 网关；更改 Docker bridge 地址时一起修改。
# SANDBOX_HOST_GATEWAY=172.17.0.1

# 后端 API 对外端口（默认：7878）
# BACKEND_PORT=7878

# 后端 API 实例数（默认：16）
# BACKEND_REPLICAS=16

# Web 客户端对外端口（默认：7939）
# WEB_CLIENT_PORT=7939
