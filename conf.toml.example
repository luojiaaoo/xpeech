[path]
session_path = "data/session"
session_history_path = "data/session/history"
session_record_yaml_path = "data/session/record"
workspace_base_path = "data/workspace_base"
sandbox_home_path = "assets/sandbox-home"
cache_path = "data/cache"
log_path = "data/logs"

[database]
# 对话记录、Web 用户与登录会话、飞书 Token、定时任务共用一个 PostgreSQL 数据库。
# 所有连接统一使用 READ COMMITTED（读已提交）隔离级别。
# 默认连接 Docker Compose 中的 postgres 服务；本地直接运行时改为 127.0.0.1 或实际数据库地址。
# 服务启动时自动建表；使用外部数据库时请预先创建数据库和账号。
host = "postgres"
port = 5432
name = "xpeech"
username = "xpeech"
password = "replace-with-a-database-password"
sslmode = "prefer"
connect_timeout = 10
# 每个进程、每个连接池的配置；多副本部署时请计入总连接数。
pool_size = 5
max_overflow = 5

[logging]
retention_days = 7
max_file_size_mb = 10

[jwt]
# Generate three distinct keys with: python -c "import secrets; print(secrets.token_hex(32))"
# Internal service-to-service trust.
secret_key = "replace-with-a-random-secret-of-at-least-32-characters"
# Shared by internal services and all channels.
algorithm = "HS256"
access_token_expire_seconds = 60

# Every channel uses its name as the JWT header kid and an independent key.
# system_identity_prompt 非空时替换 [llm] 的同名配置；custom_system_prompt 追加到 [llm] 的同名配置之后。
[jwt.channels.web_client]
secret_key = "replace-with-a-different-web-channel-secret-key"
system_identity_prompt = ""
custom_system_prompt = ""
# 可选：允许登录页通过 /?channel=crm 进入定制系统。每项包含 channel、系统名、推荐问题列表。
# channel 必须另行配置在 jwt.channels 中，使用其独立密钥。
# [[jwt.channels.web_client.allow_extra_channels]]
# channel = "crm"
# system_name = "客户服务助手"
# recommended_questions = ["如何查询客户资料？", "帮我整理本周的跟进计划"]
# 可选：组织字符串匹配任一前缀才允许登录和使用；省略或 [] 不限制。
# 通过 [organization].command_template 查询组织；查询失败或未配置则拒绝受限通道访问。
# organization_filter = ["公司/销售/", "公司/客服/"]

[jwt.channels.feishu]
secret_key = "replace-with-a-different-feishu-channel-secret"
system_identity_prompt = ""
custom_system_prompt = ""

# Custom channels use their name as the JWT header kid and an independent key.
# [jwt.channels.crm]
# secret_key = "replace-with-a-distinct-crm-secret-of-at-least-32-characters"
# system_identity_prompt = ""
# custom_system_prompt = ""

# 加载技能、MCP 和校验 Web 通道组织权限时按用户查询所属组织，此配置不绑定渠道。
# 命令的 stdout 为 UTF-8 组织字符串，例如 company/engineering/platform。
# 成功结果（含空组织）在后端按用户缓存 10 分钟。
# [organization]
# command_template = "curl --fail --silent 'https://directory.example/organization?user_id=${user_id}'"
# timeout = 10.0

[web_client]
# Web 对话原始事件历史，按用户 ID 和 channel + session_id 分文件保存。
session_history_path = "data/web_client/session_history"
max_history_days = 30
cookie_name = "xpeech_session"

[web_client.inject_prompt]
enabled = false
# ${state} 或 $state 会替换为入口随机码；命令的 stdout 将作为下一条用户消息的前缀。
command_template = "curl --fail --silent 'http://prompt-service.example/prompt?state=${state}'"

# Repeat this array table to configure more OAuth2 providers. provider_name must be unique.
[[web_client.oauth2]]
enabled = false
provider_name = "XX"
# qrcode: display a QR code; link: display a button that opens a new tab.
display_type = "qrcode"
client_id = ""
client_secret = ""
authorization_url = "https://login.example.com/oauth2/authorize"
token_url = "https://login.example.com/oauth2/token"
userinfo_url = "https://login.example.com/oauth2/userinfo"
# Set this explicitly when the Web client is behind a reverse proxy.
redirect_uri = "http://127.0.0.1:7939/api/auth/oauth2/callback"
scopes = ["openid", "profile"]
# Claim paths are jq queries against the userinfo JSON, e.g. ".data.items[0].id".
user_id_claim = ".sub"
username_claim = ".name"
# Keep false to require administrators to pre-create matching local accounts.
auto_create_users = false
use_pkce = true
token_auth_method = "client_secret_post"
# extra_authorization_params = { prompt = "login" }

[llm]
api_key = "xxxxxxxx"
api_base = "http://llm-proxy.1393074507312057.cn-wulanchabu.pai-eas.aliyuncs.com/v1"
default_model = "openai/Kimi-K2.6"
tools_python_package = "custom_tools"
default_tools = ["echo", "hello"]
system_name = "xpeech"
system_identity_prompt = ""
custom_system_prompt = ""
support_image = true
support_video = true
support_json_output = true
parallel = 4
summary_tokens = 32768
max_iterations = 40
# 历史文件保留天数，按文件修改时间计算；加载/列表时清理超期文件和非法文件名。
max_history_days = 30

[llm.parameters]
max_tokens = 32768
max_context_tokens = 262144
temperature = 1.0
top_p = 0.95
top_k = 20
min_p = 0.0
presence_penalty = 0.0
repetition_penalty = 1.0
# reasoning_effort = "medium"

[tool]
max_result_chars = 10000
max_tool_timeout = 300 # 工具自身超时之外的最终兜底上限（秒）

[tool.shell]
sandbox_idle_timeout_seconds = 600 # 所有 shell 请求结束后的空闲回收时间（秒，必须大于 0）

[tool.browser_preview]
browser_preview_base_url = "http://backend:7878/browser_preview"
browser_preview_path = "data/browser_preview"

# [tool.mcpServers.filesystem]
# description = "读写工作区文件；任务需要本地文件操作时可等待此服务就绪"
# command = "npx"
# stdio 始终按 (user_id, workspace) 隔离，不受 user_scoped 设置影响。
# stdio 通过 Linux bubblewrap 沙盒启动，cwd 为用户 workspace，HOME 为 <workspace>/home；模型工具参数保持透传
# command 及依赖须在系统运行时目录（如 /usr、/opt）或当前 workspace 内，backend 私有目录不会自动挂载
# args = ["-y", "@modelcontextprotocol/server-filesystem", "."]
# env = { API_KEY = "replace-with-service-api-key" } # 仅 stdio；禁止配置 PATH 和 HOME，两者由沙盒管理
# enabled_tools = ["*"] # 按 MCP 原始工具名匹配，支持 *、?、[abc]，例如 ["read_*", "write_?"]
# execution_request_tools = ["write_*", "edit_*"] # 支持通配符 *、?、[abc]；["*"] 表示全部，[] 表示不启用
# connect_timeout = 30
# tool_timeout = 120

[tool.mcpServers.xsct-bench]
description = "查询大模型排行榜、各场景评测分数和用例表现，支持模型对比与成本估算；涉及模型选型、能力对比或性价比分析时可等待此服务就绪。"
transport = "streamable-http"
url = "https://xsct.ai/mcp"
enabled_tools = ["*"]
execution_request_tools = [] # 按 MCP 原始工具名匹配，例如 ["write_*", "delete_*"]
connect_timeout = 30
tool_timeout = 120

# [tool.mcpServers.my-api]
# description = "查询 CRM 客户资料和订单；客户、订单相关任务可等待此服务就绪"
# filter = 'tag("crm") or org("company/engineering/")' # 省略表示公共 MCP；表达式求值为真才连接并注册，语法见 README。
# url = "https://mcp.example.com/sse"
# transport = "sse" # stdio / sse / streamable-http
# command_authorization_token_template = "curl --fail --silent 'https://auth.example.com/token?user_id=${user_id}'"
# user_scoped = false # 远程 MCP 默认跨用户共享；true 或配置 command_authorization_token_template 时按用户隔离，均空闲 20 分钟回收。
# headers = { Authorization = "Bearer ${authorization_token}", X-User-ID = "$user_id" }
# verify_tls = false # 仅用于自签名证书；生产环境优先安装并信任内部 CA
# enabled_tools = ["*"]
# execution_request_tools = ["*"]
# connect_timeout = 30
# tool_timeout = 120


[feishu]
app_id = "cli_aa8fcbaccae41cba"
app_secret = "xxxxxxx"
