# verify_tls = false # 仅用于自签名证书；生产环境优先安装并信任内部 CA
# enabled_tools = ["*"]
# execution_request_tools = ["*"]
# connect_timeout = 30
# tool_timeout = 120


[feishu]
app_id = "cli_aa8fcbaccae41cba"
app_secret = "xxxxxxx"

[feishu.lark_cli]
database_path = "docker_data/lark-token-manager/tokens.db"
