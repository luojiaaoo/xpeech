	}
	pending = &pendingDeviceAuthorization{
		AppID:                   appID,
		DeviceCode:              device.DeviceCode,
		UserCode:                device.UserCode,
		VerificationURI:         device.VerificationUri,
		VerificationURIComplete: device.VerificationUriComplete,
