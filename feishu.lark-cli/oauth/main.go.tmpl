func desiredScopeSet(cached *cachedUserToken, requested []string) []string {
	current := tokenScopes(cached)
	if len(current) == 0 {
		current = append([]string(nil), defaultScopes...)
	}
	return appendUnique(current, requested...)
}

func readyResult(token *cachedUserToken) *ensureResult {
	return &ensureResult{Token: token, Scopes: tokenScopes(token)}
}

func shouldRefreshUserToken(cached *cachedUserToken, desiredScopes []string) bool {
	return !usableAccessToken(cached) &&
		tokenHasScopes(cached, desiredScopes) &&
		reusableRefreshToken(cached)
}

func refreshUserToken(ctx context.Context, cached *cachedUserToken) (*cachedUserToken, error) {
	form := url.Values{}
	form.Set("grant_type", "refresh_token")
	form.Set("client_id", appID)
	form.Set("client_secret", appSecret)
	form.Set("refresh_token", cached.RefreshToken)

	req, err := http.NewRequestWithContext(ctx, http.MethodPost, oauthTokenEndpoint, strings.NewReader(form.Encode()))
	if err != nil {
		return nil, fmt.Errorf("create Feishu refresh request: %w", err)
	}
	req.Header.Set("Accept", "application/json")
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	resp, err := oauthHTTPClient().Do(req)
	if err != nil {
		return nil, fmt.Errorf("request Feishu user token refresh: %w", err)
	}
	defer resp.Body.Close()

	var payload struct {
		Code                  int    `json:"code"`
		Msg                   string `json:"msg"`
		Error                 string `json:"error"`
		ErrorDescription      string `json:"error_description"`
		AccessToken           string `json:"access_token"`
		RefreshToken          string `json:"refresh_token"`
		ExpiresIn             int    `json:"expires_in"`
		RefreshTokenExpiresIn int    `json:"refresh_token_expires_in"`
		Scope                 string `json:"scope"`
	}
	if err := decodeJSONResponse(resp.Body, &payload); err != nil {
		return nil, fmt.Errorf("decode Feishu refresh response: %w", err)
	}
	if resp.StatusCode < 200 || resp.StatusCode >= 300 || payload.Code != 0 || payload.Error != "" {
		return nil, &refreshTokenError{
			statusCode:            resp.StatusCode,
			code:                  payload.Code,
			oauthError:            payload.Error,
			message:               firstNonEmpty(payload.ErrorDescription, payload.Msg, payload.Error),
			requiresAuthorization: refreshResponseRequiresAuthorization(payload.Code, payload.Error),
		}
	}

	responseProblem := validateRefreshResponse(cached, payload.AccessToken, payload.RefreshToken,
		payload.ExpiresIn, payload.RefreshTokenExpiresIn)
	if responseProblem != "" {
		return nil, &refreshTokenError{
			statusCode:            resp.StatusCode,
			code:                  payload.Code,
			message:               responseProblem,
			requiresAuthorization: true,
		}
	}

	now := time.Now().Unix()
	return &cachedUserToken{
		AppID:                 appID,
		AccessToken:           payload.AccessToken,
		RefreshToken:          payload.RefreshToken,
		Scope:                 firstNonEmpty(payload.Scope, cached.Scope),
		ExpiresAt:             now + int64(payload.ExpiresIn),
		RefreshTokenExpiresAt: now + int64(payload.RefreshTokenExpiresIn),
	}, nil
}

func validateRefreshResponse(
	cached *cachedUserToken,
	accessToken string,
	refreshToken string,
	expiresIn int,
	refreshExpiresIn int,
) string {
	switch {
	case accessToken == "":
		return "successful response is missing access_token"
	case refreshToken == "":
		return "successful response is missing the rotated refresh_token"
	case cached != nil && refreshToken == cached.RefreshToken:
		return "successful response did not rotate refresh_token"
	case expiresIn <= 0:
		return "successful response has invalid expires_in"
	case refreshExpiresIn <= 0:
		return "successful response has invalid refresh_token_expires_in"
	default:
		return ""
	}
}

func validateIssuedUserToken(token *cachedUserToken) error {
	switch {
	case token == nil:
		return errors.New("missing token")
	case token.AccessToken == "":
		return errors.New("missing access_token")
	case token.RefreshToken == "":
		return errors.New("missing refresh_token")
	case token.ExpiresAt <= time.Now().Unix():
		return errors.New("invalid expires_in")
	case token.RefreshTokenExpiresAt <= time.Now().Unix():
		return errors.New("invalid refresh_token_expires_in")
	default:
		return nil
	}
}

func refreshResponseRequiresAuthorization(code int, oauthError string) bool {
	switch code {
	case feishuRefreshInvalid, feishuRefreshExpired, feishuRefreshRevoked, feishuRefreshAlreadyUsed:
		return true
	}
	switch strings.ToLower(strings.TrimSpace(oauthError)) {
	case "invalid_grant", "invalid_refresh_token", "refresh_token_expired", "refresh_token_revoked":
		return true
	default:
		return false
	}
}

func refreshFailureRequiresAuthorization(err error) bool {
	var refreshErr *refreshTokenError
	return errors.As(err, &refreshErr) && refreshErr.requiresAuthorization
}

func pendingUsable(pending *pendingDeviceAuthorization, scopes []string) bool {
	return pending != nil &&
		pending.AppID == appID &&
		pending.DeviceCode != "" &&
		pending.ExpiresAt > time.Now().Unix() &&
		sameScopes(pending.Scopes, scopes)
}

func sameScopes(left, right []string) bool {
	if len(left) != len(right) {
		return false
	}
	wanted := make(map[string]struct{}, len(left))
	for _, scope := range left {
		wanted[scope] = struct{}{}
	}
	for _, scope := range right {
		if _, ok := wanted[scope]; !ok {
			return false
		}
	}
	return true
}

func parseScopeList(raw string) ([]string, error) {
	fields := strings.FieldsFunc(raw, func(r rune) bool {
		return r == ',' || r == ';' || r == ' ' || r == '\t' || r == '\n' || r == '\r'
	})
	if len(fields) == 0 {
		return nil, errors.New("scope must not be empty")
	}
	for _, scope := range fields {
		if strings.ContainsAny(scope, "&=?#") {
			return nil, fmt.Errorf("invalid scope %q", scope)
		}
	}
	return appendUnique(nil, fields...), nil
}

func appendUnique(existing []string, values ...string) []string {
	seen := make(map[string]struct{}, len(existing)+len(values))
	result := make([]string, 0, len(existing)+len(values))
	for _, value := range append(existing, values...) {
		value = strings.TrimSpace(value)
		if value == "" {
			continue
		}
		if _, ok := seen[value]; ok {
			continue
		}
		seen[value] = struct{}{}
		result = append(result, value)
	}
	return result
}

func tokenScopes(cached *cachedUserToken) []string {
	if cached == nil || strings.TrimSpace(cached.Scope) == "" {
		return nil
	}
	return strings.Fields(cached.Scope)
}

func tokenHasScopes(cached *cachedUserToken, wanted []string) bool {
	available := make(map[string]struct{})
	for _, scope := range tokenScopes(cached) {
		available[scope] = struct{}{}
	}
	for _, scope := range wanted {
		if _, ok := available[scope]; !ok {
			return false
		}
	}
	return true
}

func usableAccessToken(cached *cachedUserToken) bool {
	return cached != nil && cached.AccessToken != "" &&
		time.Now().Add(tokenExpirySkew).Unix() < cached.ExpiresAt
}

func reusableRefreshToken(cached *cachedUserToken) bool {
	return cached != nil && cached.RefreshToken != "" &&
		cached.RefreshTokenExpiresAt > 0 &&
		time.Now().Add(tokenExpirySkew).Unix() < cached.RefreshTokenExpiresAt
}

func oauthHTTPClient() *http.Client {
	return &http.Client{Timeout: httpTimeout}
}

func oauthHTTPClientWithContext(ctx context.Context) *http.Client {
	return &http.Client{
		Timeout: httpTimeout,
		Transport: contextRoundTripper{
			ctx:  ctx,
			base: http.DefaultTransport,
		},
	}
}

func userTokenCachePath() (string, error) {
	directory, err := xpeechConfigDirectory()
	if err != nil {
		return "", err
	}
	return filepath.Join(directory, "lark-cli-user-token.json"), nil
}

func pendingAuthorizationPath() (string, error) {
	directory, err := xpeechConfigDirectory()
	if err != nil {
		return "", err
	}
	return filepath.Join(directory, "lark-cli-oauth-pending.json"), nil
}

func xpeechConfigDirectory() (string, error) {
	if configHome := os.Getenv("XDG_CONFIG_HOME"); configHome != "" {
		return filepath.Join(configHome, "xpeech"), nil
	}
	home, err := os.UserHomeDir()
	if err != nil {
		return "", fmt.Errorf("resolve home directory for lark-cli token cache: %w", err)
	}
	return filepath.Join(home, ".config", "xpeech"), nil
}

func loadUserToken(path string) (*cachedUserToken, error) {
	var cached cachedUserToken
	if err := loadPrivateJSON(path, &cached); err != nil {
		return nil, err
	}
	if cached.AppID == "" || cached.AppID != appID {
		return nil, nil
	}
	return &cached, nil
}

func loadPendingAuthorization(path string) (*pendingDeviceAuthorization, error) {
	var pending pendingDeviceAuthorization
	if err := loadPrivateJSON(path, &pending); err != nil {
		return nil, err
	}
	if pending.AppID == "" {
		return nil, nil
	}
	return &pending, nil
}

func loadPrivateJSON(path string, target any) error {
	data, err := os.ReadFile(path)
	if errors.Is(err, os.ErrNotExist) {
		return nil
	}
	if err != nil {
		return fmt.Errorf("read %s: %w", filepath.Base(path), err)
	}
	if err := json.Unmarshal(data, target); err != nil {
		return fmt.Errorf("decode %s: %w", filepath.Base(path), err)
	}
	return nil
}

func discardCachedRefreshToken(path string, cached *cachedUserToken) (*cachedUserToken, error) {
	if cached == nil || cached.RefreshToken == "" {
		return cached, nil
	}
	invalidated := *cached
	invalidated.RefreshToken = ""
	invalidated.RefreshTokenExpiresAt = 0
	if err := saveUserTokenReliably(path, &invalidated); err != nil {
		return nil, fmt.Errorf("discard unusable refresh token: %w", err)
	}
	return &invalidated, nil
}

func saveUserTokenReliably(path string, token *cachedUserToken) error {
	var lastErr error
	for attempt := 1; attempt <= userTokenSaveAttempts; attempt++ {
		lastErr = savePrivateJSON(path, token)
		if lastErr == nil || cachedUserTokensEqual(loadUserTokenIgnoringError(path), token) {
			return nil
		}
		if attempt < userTokenSaveAttempts {
			time.Sleep(userTokenSaveRetryInterval)
		}
	}
	return fmt.Errorf(
		"persist user token after %d attempts; reauthorization may be required: %w",
		userTokenSaveAttempts,
		lastErr,
	)
}

func loadUserTokenIgnoringError(path string) *cachedUserToken {
	token, err := loadUserToken(path)
	if err != nil {
		return nil
	}
	return token
}

func cachedUserTokensEqual(left *cachedUserToken, right *cachedUserToken) bool {
	return left != nil && right != nil &&
		left.AppID == right.AppID &&
		left.AccessToken == right.AccessToken &&
		left.RefreshToken == right.RefreshToken &&
		left.Scope == right.Scope &&
		left.ExpiresAt == right.ExpiresAt &&
		left.RefreshTokenExpiresAt == right.RefreshTokenExpiresAt
}

func probePrivateJSONWrite(path string) error {
	if err := ensurePrivateDirectory(path); err != nil {
		return err
	}
	temporary, err := os.CreateTemp(filepath.Dir(path), ".lark-oauth-probe-*")
	if err != nil {
		return fmt.Errorf("create token cache write probe: %w", err)
	}
	temporaryPath := temporary.Name()
	defer os.Remove(temporaryPath)
	if err := temporary.Chmod(0o600); err != nil {
		temporary.Close()
		return fmt.Errorf("protect token cache write probe: %w", err)
	}
	if _, err := temporary.Write(make([]byte, privateWriteProbeSize)); err != nil {
		temporary.Close()
		return fmt.Errorf("write token cache probe: %w", err)
	}
	if err := temporary.Sync(); err != nil {
		temporary.Close()
		return fmt.Errorf("sync token cache write probe: %w", err)
	}
	if err := temporary.Close(); err != nil {
		return fmt.Errorf("close token cache write probe: %w", err)
	}
	if err := os.Remove(temporaryPath); err != nil {
		return fmt.Errorf("remove token cache write probe: %w", err)
	}
	return nil
}

func savePrivateJSON(path string, value any) error {
	data, err := json.MarshalIndent(value, "", "  ")
	if err != nil {
		return fmt.Errorf("encode %s: %w", filepath.Base(path), err)
	}
	data = append(data, '\n')
	if err := ensurePrivateDirectory(path); err != nil {
		return err
	}
	temporary, err := os.CreateTemp(filepath.Dir(path), ".lark-oauth-*")
	if err != nil {
		return fmt.Errorf("create temporary token cache: %w", err)
	}
	temporaryPath := temporary.Name()
	defer os.Remove(temporaryPath)
	if err := temporary.Chmod(0o600); err != nil {
		temporary.Close()
		return fmt.Errorf("protect temporary token cache: %w", err)
	}
	if _, err := temporary.Write(data); err != nil {
		temporary.Close()
		return fmt.Errorf("write temporary token cache: %w", err)
	}
	if err := temporary.Sync(); err != nil {
		temporary.Close()
		return fmt.Errorf("sync temporary token cache: %w", err)
	}
	if err := temporary.Close(); err != nil {
		return fmt.Errorf("close temporary token cache: %w", err)
	}
	if err := os.Rename(temporaryPath, path); err != nil {
		return fmt.Errorf("replace %s: %w", filepath.Base(path), err)
	}
	if err := syncDirectory(filepath.Dir(path)); err != nil {
		return fmt.Errorf("sync token cache directory: %w", err)
	}
	return nil
}

func ensurePrivateDirectory(path string) error {
	directory := filepath.Dir(path)
	if err := os.MkdirAll(directory, 0o700); err != nil {
		return fmt.Errorf("create token cache directory: %w", err)
	}
	if err := os.Chmod(directory, 0o700); err != nil {
		return fmt.Errorf("protect token cache directory: %w", err)
	}
	return nil
}

func syncDirectory(path string) error {
	directory, err := os.Open(path)
	if err != nil {
		return err
	}
	defer directory.Close()
	return directory.Sync()
}

func removeStalePendingAuthorization() {
	pendingPath, err := pendingAuthorizationPath()
	if err == nil {
		removePendingAuthorization(pendingPath)
	}
}

func removePendingAuthorization(path string) {
	if err := os.Remove(path); err != nil && !errors.Is(err, os.ErrNotExist) {
		fmt.Fprintf(os.Stderr, "lark-oauth: remove expired pending authorization: %v\n", err)
	}
}

func decodeJSONResponse(reader io.Reader, target any) error {
	decoder := json.NewDecoder(io.LimitReader(reader, 1<<20))
	return decoder.Decode(target)
}

func firstNonEmpty(values ...string) string {
	for _, value := range values {
		if value != "" {
			return value
		}
	}
	return ""
}
