	flags.SetOutput(os.Stderr)
	flags.Var(&requested, "scope", "additional scope; repeat or separate values with commas/spaces")
	flags.Var(&requested, "scopes", "alias for --scope")
	if err := flags.Parse(args); err != nil {
		return 2
	}
	for _, raw := range flags.Args() {
		scopes, err := parseScopeList(raw)
		if err != nil {
			fmt.Fprintf(os.Stderr, "lark-oauth: %v\n", err)
			return 2
		}
		requested = appendUnique(requested, scopes...)
	}

	result, err := ensureUserToken(context.Background(), requested)
	if err != nil {
		fmt.Fprintf(os.Stderr, "lark-oauth: %v\n", err)
		return 1
	}
	if result.AuthorizationURL != "" {
		fmt.Fprintf(os.Stderr, "请打开以下地址完成飞书设备授权：\n%s\n", result.AuthorizationURL)
		if result.UserCode != "" {
			fmt.Fprintf(os.Stderr, "用户码：%s\n", result.UserCode)
		}
		fmt.Fprintln(os.Stderr, "授权完成后，请重新执行刚才的命令。")
		return 2
	}

	fmt.Printf("飞书用户令牌已就绪（scope: %s）\n", strings.Join(result.Scopes, " "))
	return 0
}

